{:paths ["src"]
 ;; Darkstar is the datastar half. It exists so `remuda` can stay free of the DOM:
 ;; everything here knows about CSS selectors, patch modes, `@post(...)`
 ;; expressions and SSE framing, and none of that belongs in a library whose job is
 ;; holding view state.
 ;;
 ;; During development remuda is a :local/root; switch to a released coordinate
 ;; before publishing.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.github.brettatoms/remuda {:local/root "../remuda"}
        dev.data-star.clojure/sdk {:mvn/version "1.0.0-RC11"}}

 :aliases {;; clojure -M:test
           :test {:extra-paths ["test"]
                  :extra-deps {com.gfredericks/test.chuck {:mvn/version "0.2.15"}
                               lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :main-opts ["-m" "kaocha.runner"]}

           ;; The vertical slice: one component, bare Ring, real browser.
           ;; Kept out of :deps so darkstar itself needs no server.
           :slice {:extra-paths ["dev" "dev/resources"]
                   :extra-deps {dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                                dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                                com.cnuernber/charred {:mvn/version "1.041"}
                                ring/ring-core {:mvn/version "1.15.5"}
                                ring/ring-jetty-adapter {:mvn/version "1.15.5"}
                                org.clojure/tools.logging {:mvn/version "1.3.1"}
                                ;; Benchmarks only: a Source doing real I/O, so
                                ;; fan-out numbers are not an artifact of a free
                                ;; in-memory fetch (§7.1).
                                org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
                                com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}}
                   :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           ;; The second adapter and the chat example.
           :example {:extra-paths ["examples" "examples/resources"]
                     :extra-deps {com.github.brettatoms/zodiac {:mvn/version "1.0.119"}
                                  com.github.brettatoms/zodiac-sql {:mvn/version "0.3.27"}
                                  dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                                  dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC11"}
                                  http-kit/http-kit {:mvn/version "2.9.0-beta3"}
                                  dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                                  com.cnuernber/charred {:mvn/version "1.041"}
                                  org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
                                  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
                                  integrant/integrant {:mvn/version "1.0.1"}
                                  org.clojure/tools.logging {:mvn/version "1.3.1"}}
                     :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           ;; Soak test: the same engine behind Jetty and http-kit under a
           ;; constrained heap. See dev/soak.clj for findings and caveats.
           :soak {:extra-paths ["dev" "examples" "examples/resources"]
                  :extra-deps {dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                               dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC11"}
                               http-kit/http-kit {:mvn/version "2.9.0-beta3"}
                               dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                               com.cnuernber/charred {:mvn/version "1.041"}
                               org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
                               com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
                               ring/ring-core {:mvn/version "1.15.5"}
                               ring/ring-jetty-adapter {:mvn/version "1.15.5"}
                               org.clojure/tools.logging {:mvn/version "1.3.1"}}
                  ;; Heap is set per-run on the command line so 2g and 4g are the
                  ;; same binary under different limits. -Xss512k keeps
                  ;; platform-thread stacks small so thread-per-connection is not
                  ;; penalised by the default 1MB reservation.
                  :jvm-opts ["-Xss512k" "-XX:+UseG1GC"
                             "-XX:-OmitStackTraceInFastThrow"]}

           ;; clojure -M:clj-kondo --lint src test
           :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.05.25"}}
                       :main-opts ["-m" "clj-kondo.main"]}

           ;; clojure -M:cljfmt check|fix
           :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
                    :main-opts ["-m" "cljfmt.main"]}}}
