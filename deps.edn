{:paths ["src"]
 ;; Darkstar: server-held UI state over Datastar.
 ;;
 ;; A set of independent conveniences rather than a framework. `action` builds
 ;; `@post(...)` expressions, `watch` + `live` track which fragments depend on what and
 ;; patch only those, `diagnose` catches the mistakes `watch` makes silent, `pubsub`
 ;; coalesces invalidation hints, `source` is a one-method read protocol. Each is usable
 ;; without the others, and an application can push patches by hand and use none of
 ;; them.
 ;;
 ;; Merged from a former two-artifact split (remuda + darkstar). The split's premise was
 ;; that the state engine could stay free of the DOM and be reused elsewhere; after the
 ;; view-and-diff engine was deleted, what remained was ~500 lines with no code coupling
 ;; to justify separate CI, versioning and release cycles.
 ;;
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        dev.data-star.clojure/sdk {:mvn/version "1.0.0-RC11"}}

 :aliases {;; clojure -M:test
           :test {:extra-paths ["test"]
                  :extra-deps {com.gfredericks/test.chuck {:mvn/version "0.2.15"}
                               lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :main-opts ["-m" "kaocha.runner"]}

           ;; Soak test: the same component behind Jetty and http-kit under a
           ;; constrained heap. See dev/soak.clj for findings and caveats — it leads
           ;; with the harness errors that produced earlier wrong numbers.
           :soak {:extra-paths ["dev"]
                  :extra-deps {dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                               dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC11"}
                               http-kit/http-kit {:mvn/version "2.9.0-beta3"}
                               dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                               com.cnuernber/charred {:mvn/version "1.041"}
                               org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
                               com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
                               ring/ring-core {:mvn/version "1.15.5"}
                               ring/ring-jetty-adapter {:mvn/version "1.15.5"}
                               org.clojure/tools.logging {:mvn/version "1.3.1"}}
                  ;; Heap is set per-run on the command line so 2g and 4g are the
                  ;; same binary under different limits. -Xss512k keeps
                  ;; platform-thread stacks small so thread-per-connection is not
                  ;; penalised by the default 1MB reservation.
                  :jvm-opts ["-Xss512k" "-XX:+UseG1GC"
                             "-XX:-OmitStackTraceInFastThrow"]}

           ;; clojure -M:dev:test — kept for symmetry with dependents; there are no
           ;; sibling libraries to override any more.
           ;; instead of a released version. :deps pins a released coordinate so a
           ;; published artifact is usable, but that version cannot exist yet for an
           ;; unpublished sibling, and it moves with every upstream commit. CI uses
           ;; this alias for the same reason.
           ;; clojure -T:build jar | deploy
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}

           ;; clojure -M:clj-kondo --lint src test
           :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.05.25"}}
                       :main-opts ["-m" "clj-kondo.main"]}

           ;; clojure -M:cljfmt check|fix
           :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
                    :main-opts ["-m" "cljfmt.main"]}}}
